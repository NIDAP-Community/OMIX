{
	"version": 1,
	"base_image": "codeocean/mosuite:v0.3.2",
	"post_install": true,
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"rcran": {
			"packages": [
				{
					"name": "getopt",
					"version": "1.21.1"
				},
				{
					"name": "optparse",
					"version": "1.8.2"
				}
			],
			"use_rcache": true
		}
	}
}