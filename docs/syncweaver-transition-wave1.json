{
  "schema_version": "1.0.0",
  "contract_kind": "omix-syncweaver-transition-preparation",
  "status": "preparation_only",
  "work_item": "https://github.com/NIDAP-Community/OMIX/issues/44",
  "canonical_repository": "https://github.com/NIDAP-Community/OMIX",
  "preparation_commit": "eee4433cd74d0ce9bd1daba1571ca6312cba7ea2",
  "policy": {
    "scientific_flow": "canonical_to_adapter_only",
    "scientific_authority": "canonical_commit_and_sha256",
    "conflict_resolution": "stop_and_review",
    "timestamp_resolution_allowed": false,
    "all_unlisted_adapter_paths_protected": true,
    "automation_metadata_paths": [
      ".syncweaver-lock.json"
    ],
    "stop_conditions": [
      {
        "id": "dirty_worktree",
        "description": "Stop before planning or writing when either checkout has tracked or untracked changes. Preserve the diff; do not stash, reset, or overwrite it automatically."
      },
      {
        "id": "unexpected_head",
        "description": "Stop when the canonical or adapter checkout is not at the exact commit declared for the proposal. Refresh the proposal from reviewed repository state."
      },
      {
        "id": "divergent_history",
        "description": "Stop when the adapter target branch is not a descendant of the recorded adapter baseline or when the canonical source is not reachable from the reviewed canonical history."
      },
      {
        "id": "host_scientific_edit",
        "description": "Stop when a managed destination hash differs from both its recorded adapter baseline and the declared canonical source hash. Report the byte diff for review; never choose a version by modification time."
      },
      {
        "id": "managed_tree_mismatch",
        "description": "Stop when the complete canonical R tree or adapter code/functions tree contains an unlisted, missing, renamed, or symlinked scientific file. The mapping must be reviewed as a complete tree before synchronization."
      },
      {
        "id": "source_record_disagreement",
        "description": "Stop when OMIX_MODULE_SOURCE.md disagrees with the declared canonical commit, module version, interface version, path mapping, or SHA-256 evidence."
      },
      {
        "id": "protected_path_change",
        "description": "Stop when a proposal changes any adapter path other than an allowlisted scientific destination or the documented automation metadata path."
      },
      {
        "id": "validation_failure",
        "description": "Stop when any required canonical, mapping, contract, adapter, or representative-fixture check fails."
      }
    ],
    "required_pre_sync_checks": [
      "clean_worktrees",
      "exact_commits",
      "non_divergent_history",
      "module_and_interface_versions",
      "complete_source_and_destination_trees",
      "baseline_sha256_parity",
      "source_record_consistency",
      "canonical_module_tests",
      "adapter_contract_and_fixture_tests"
    ],
    "required_post_sync_checks": [
      "proposed_sha256_parity",
      "managed_tree_completeness",
      "protected_paths_unchanged",
      "source_record_and_generated_lock_consistency",
      "canonical_module_tests",
      "adapter_contract_and_fixture_tests",
      "omix_contract_checker",
      "beacon_independent_parity_review"
    ],
    "external_release_gates": [
      "code_ocean_validation",
      "immutable_runtime_digest",
      "explicit_release_approval"
    ]
  },
  "adapters": [
