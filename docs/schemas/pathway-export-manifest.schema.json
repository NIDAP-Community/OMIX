{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NIDAP-Community/OMIX/blob/main/docs/schemas/pathway-export-manifest.schema.json",
  "title": "OMIX pathway data export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "export_version",
    "created_at",
    "content_profile",
    "generator",
    "upstream",
    "sources",
    "organism_tax_ids",
    "identifier_namespaces",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "export_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "export_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_profile": {
      "enum": ["open", "restricted-site", "custom"]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_commit"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "snapshot_id"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "snapshot_id": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "name",
          "version",
          "retrieved_at",
          "origin_url",
          "license_name",
          "license_url",
          "redistribution",
          "included",
          "notes"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "origin_url": {"type": "string", "format": "uri"},
          "license_name": {"type": "string", "minLength": 1},
          "license_url": {"type": "string", "format": "uri"},
          "redistribution": {
            "enum": ["allowed", "restricted", "prohibited", "unknown"]
          },
          "included": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    },
    "organism_tax_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "identifier_namespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["genesets", "memberships", "notice"],
      "properties": {
        "genesets": {"$ref": "#/$defs/tableFile"},
        "memberships": {"$ref": "#/$defs/tableFile"},
        "notice": {"$ref": "#/$defs/plainFile"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "content_profile": {"const": "open"}
        },
        "required": ["content_profile"]
      },
      "then": {
        "properties": {
          "sources": {
            "items": {
              "if": {
                "properties": {"included": {"const": true}},
                "required": ["included"]
              },
              "then": {
                "properties": {"redistribution": {"const": "allowed"}},
                "required": ["redistribution"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plainFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "media_type": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tableFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "sha256", "row_count"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "media_type": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "row_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
